<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_setting_pos_discount_cash" model="ir.ui.view">
        <field name="name">res.config.settings.pos.discount.cash</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="inside">
                <setting string="Enable cash payment discount">
                    <field name="pos_active_discount_cash_payment"
                           widget="toggle_button"/>
                </setting>
                <setting string="Discount product for cash payments">
                    <field name="pos_product_discount_id"/>
                </setting>
                <setting string="Discount amount for cash payment" >
                    <field name="pos_discount_cash_payment" widget="percentage"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>

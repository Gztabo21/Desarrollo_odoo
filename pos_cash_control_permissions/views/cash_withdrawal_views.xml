<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_cash_withdrawal_tree" model="ir.ui.view">
        <field name="name">pos.cash.withdrawal.tree</field>
        <field name="model">pos.cash.withdrawal</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="user_id"/>
                <field name="type" decoration-danger="type == 'out'" decoration-success="type == 'in'"/>
                <field name="amount" sum="Total"/>
                <field name="reason"/>
                <field name="session_id"/>
            </list>
        </field>
    </record>

    <record id="pos_cash_withdrawal_form" model="ir.ui.view">
        <field name="name">pos.cash.withdrawal.form</field>
        <field name="model">pos.cash.withdrawal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="type"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="session_id"/>
                            <field name="reason"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_cash_withdrawal_search" model="ir.ui.view">
        <field name="name">pos.cash.withdrawal.search</field>
        <field name="model">pos.cash.withdrawal</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="session_id"/>
                <field name="reason"/>
                <filter name="filter_in" string="Cash In" domain="[('type', '=', 'in')]"/>
                <filter name="filter_out" string="Cash Out" domain="[('type', '=', 'out')]"/>
                <separator/>
                <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                <filter name="group_by_session" string="Session" context="{'group_by': 'session_id'}"/>
                <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_pos_cash_withdrawal" model="ir.actions.act_window">
        <field name="name">Cash Moves</field>
        <field name="res_model">pos.cash.withdrawal</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pos_cash_withdrawal_search"/>
    </record>

    <menuitem id="menu_pos_cash_withdrawal"
              name="Cash Moves"
              parent="point_of_sale.menu_point_config_product"
              action="action_pos_cash_withdrawal"
              groups="point_of_sale.group_pos_user,point_of_sale.group_pos_manager,pos_cash_control_permissions.group_pos_cash_withdrawal"
              sequence="50"/>
</odoo>
